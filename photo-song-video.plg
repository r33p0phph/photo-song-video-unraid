<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "photo-song-video">
<!ENTITY version "2026.11.21d">
<!ENTITY pluginURL "https://raw.githubusercontent.com/r33p0phph/photo-song-video-unraid/main/photo-song-video.plg">
<!ENTITY emhttp "/usr/local/emhttp/plugins/&name;">
<!ENTITY flash "/boot/config/plugins/&name;">
]>
<PLUGIN name="&name;" author="Built with Claude" version="&version;" min="6.12.0" pluginURL="&pluginURL;">

<CHANGES>
###2026.11.21d
- The song slot also takes a video and uses its sound. Damaged or cut-short photos now open instead of being refused.
- Updating the plugin now also recreates a container that was made from the Docker tab.
- Builds the app image on the server, adds it to the Docker tab and starts it. Uses the NVIDIA GPU (NVENC) when the Nvidia Driver plugin is installed, otherwise the CPU.
</CHANGES>

<!-- folders. The two files below are removed first because Unraid keeps an inline file that already exists, which would leave an old copy behind on update -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &emhttp; &flash;
rm -f &emhttp;/payload.b64 /usr/local/sbin/psv-setup
</INLINE>
</FILE>

<!-- the app, packed as a base64 tarball -->
